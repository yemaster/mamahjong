# Published application images. Use a version tag here when a rollback pin is needed.
MAMAHJONG_PROJECT_NAME=mamahjong-prod
MAMAHJONG_SERVER_IMAGE=registry.abstrax.cn/mamahjong/server:latest
MAMAHJONG_WEB_IMAGE=registry.abstrax.cn/mamahjong/web:latest

# The frontend proxies /api and WebSocket traffic to this URL at runtime.
# Keep the default for this Compose stack; omit the trailing slash.
MAMAHJONG_SERVER_URL=http://server:8080

# The web container is the only HTTP entry point.
MAMAHJONG_WEB_HOST=127.0.0.1
MAMAHJONG_WEB_PORT=8080

MAMAHJONG_DATABASE_NAME=mamahjong
MAMAHJONG_DATABASE_USER=mamahjong
# Required. Use URL-safe characters (A-Z, a-z, 0-9, _ and -).
MAMAHJONG_DATABASE_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_DATABASE_PASSWORD

RUST_LOG=info
