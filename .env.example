# Host-side bind address. Keep loopback unless a TLS reverse proxy or firewall is configured.
MAMAHJONG_HOST=127.0.0.1
MAMAHJONG_PORT=8080

# PostgreSQL is reachable only inside the Docker Compose network.
MAMAHJONG_DATABASE_NAME=mamahjong
MAMAHJONG_DATABASE_USER=mamahjong
MAMAHJONG_DATABASE_PASSWORD=mamahjong-local-password

# Rust tracing filter.
RUST_LOG=info

# Leave empty to disable the management console. Use at least 12 bytes.
MAMAHJONG_ADMIN_LOGIN_NAME=admin
MAMAHJONG_ADMIN_PASSWORD=
MAMAHJONG_ADMIN_NICKNAME=管理员

# Set true when the public endpoint uses HTTPS.
MAMAHJONG_ADMIN_COOKIE_SECURE=false
