# The web container is the only host-side HTTP entry point.
MAMAHJONG_WEB_HOST=127.0.0.1
MAMAHJONG_WEB_PORT=8080

# PostgreSQL is reachable only inside the Docker Compose network.
MAMAHJONG_DATABASE_NAME=mamahjong
MAMAHJONG_DATABASE_USER=mamahjong
MAMAHJONG_DATABASE_PASSWORD=mamahjong-local-password

# Rust tracing filter.
RUST_LOG=info
