{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "麻麻的将",
  "version": "0.1.0",
  "identifier": "com.mamahjong.desktop",
  "build": {
    "frontendDist": "../game-web/dist",
    "devUrl": "http://localhost:5173/game/",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "title": "麻麻的将",
    "windows": [
      {
        "title": "麻麻的将",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 768,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: tauri://localhost https://asset.localhost; connect-src 'self' http://127.0.0.1:8080 http://localhost:8080 ws://127.0.0.1:8080 ws://localhost:8080"
    }
  }
}
